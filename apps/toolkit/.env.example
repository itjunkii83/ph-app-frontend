# Storage base URL for resolving relative presentation media keys
# (e.g. "presentations/media/bg.jpg") into tokenless public URLs via the Firebase
# download endpoint. Moving buckets or fronting a CDN is a change here, not a data
# rewrite. Copy this file to .env.local for local dev.
NEXT_PUBLIC_STORAGE_BASE_URL=https://firebasestorage.googleapis.com/v0/b/humanos-8eeb8.firebasestorage.app/o/
