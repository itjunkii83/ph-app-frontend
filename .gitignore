# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (recursive: root + every workspace package)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
tmp/

# next.js (recursive)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (recursive; never commit secrets like the studio OPENAI key)
.env*
!.env.example

# firebase
service-account.json
firebase-debug.log
.firebase/

# vercel
.vercel

# typescript (recursive)
*.tsbuildinfo
next-env.d.ts
